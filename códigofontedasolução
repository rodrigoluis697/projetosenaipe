import glob
import numpy as np
import pandas as pd
from sklearn.model_selection import LeaveOneGroupOut
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from lightgbm import LGBMRegressor

from src.data_loader import parse_filename, load_signal_file
from src.feature_extraction import process_file_windows

def main():
    csv_files = glob.glob('data/*.csv')
    if not csv_files:
        return
        
    print("--- Treinando Softsensor de Temperatura (Módulo 2) ---")
    all_features = []
    for filepath in csv_files:
        meta = parse_filename(filepath)
        df = load_signal_file(filepath)
        # Janelas maiores (2s) adequadas à dinâmica da temperatura
        df_feat = process_file_windows(df, meta, window_size_sec=2.0, overlap=0.5)
        all_features.append(df_feat)
        
    dataset = pd.concat(all_features, ignore_index=True)
    
    X = dataset.drop(columns=['file_id', 'label', 'target_temp_mean', 'target_temp_last'])
    y = dataset['target_temp_mean']
    groups = dataset['file_id']
    
    logo = LeaveOneGroupOut()
    model = LGBMRegressor(n_estimators=150, learning_rate=0.05, random_state=42, verbose=-1)
    
    y_true_all, y_pred_all = [], []
    
    for train_idx, test_idx in logo.split(X, y, groups=groups):
        X_train, X_test = X.iloc[train_idx], X.iloc[test_idx]
        y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]
        
        model.fit(X_train, y_train)
        preds = model.predict(X_test)
        
        y_true_all.extend(y_test)
        y_pred_all.extend(preds)
        
    print("\n--- Desempenho do Softsensor ---")
    print(f"RMSE: {np.sqrt(mean_squared_error(y_true_all, y_pred_all)):.4f} °C")
    print(f"MAE:  {mean_absolute_error(y_true_all, y_pred_all):.4f} °C")
    print(f"R²:   {r2_score(y_true_all, y_pred_all):.4f}")

if __name__ == '__main__':
    main()
