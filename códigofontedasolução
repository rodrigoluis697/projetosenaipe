import numpy as np
import pandas as pd
from scipy.stats import skew, kurtosis
from scipy.signal import welch

def extract_time_domain_features(signal: np.ndarray, prefix: str) -> dict:
    """Calcula estatísticas no domínio do tempo."""
    rms = np.sqrt(np.mean(signal**2))
    peak = np.max(np.abs(signal))
    std = np.std(signal)
    mean = np.mean(signal)
    
    # Prevenção contra divisão por zero
    crest_factor = peak / (rms + 1e-12)
    shape_factor = rms / (np.mean(np.abs(signal)) + 1e-12)
    impulse_factor = peak / (np.mean(np.abs(signal)) + 1e-12)
    margin_factor = peak / ((np.mean(np.sqrt(np.abs(signal))))**2 + 1e-12)

    return {
        f'{prefix}_mean': mean,
        f'{prefix}_std': std,
        f'{prefix}_rms': rms,
        f'{prefix}_peak': peak,
        f'{prefix}_peak2peak': np.ptp(signal),
        f'{prefix}_skew': skew(signal),
        f'{prefix}_kurtosis': kurtosis(signal),
        f'{prefix}_crest_factor': crest_factor,
        f'{prefix}_shape_factor': shape_factor,
        f'{prefix}_impulse_factor': impulse_factor,
        f'{prefix}_margin_factor': margin_factor,
    }

def extract_frequency_features(signal: np.ndarray, fs: int, fundamental_freq: float, prefix: str) -> dict:
    """Extrai Densidade Espectral de Potência e bandas harmônicas (Order Tracking proxy)."""
    freqs, psd = welch(signal, fs=fs, nperseg=fs // 4)
    
    features = {
        f'{prefix}_spectral_centroid': np.sum(freqs * psd) / (np.sum(psd) + 1e-12),
        f'{prefix}_spectral_energy': np.sum(psd),
        f'{prefix}_spectral_spread': np.sqrt(np.sum(((freqs - (np.sum(freqs * psd) / (np.sum(psd) + 1e-12)))**2) * psd) / (np.sum(psd) + 1e-12))
    }
    
    # Energias das bandas harmônicas da rotação (1X, 2X, 3X)
    for order in [1, 2, 3]:
        center = order * fundamental_freq
        bandwidth = 2.0  # Hz
        mask = (freqs >= (center - bandwidth)) & (freqs <= (center + bandwidth))
        features[f'{prefix}_energy_{order}X'] = np.sum(psd[mask])
        
    return features

def process_file_windows(df: pd.DataFrame, meta: dict, window_size_sec: float = 1.0, overlap: float = 0.5) -> pd.DataFrame:
    """Segmenta o sinal em janelas e extrai a matriz de atributos."""
    fs = 42000
    window_samples = int(window_size_sec * fs)
    step_samples = int(window_samples * (1.0 - overlap))
    total_samples = len(df)
    
    features_list = []
    
    sensor_cols = ['acc_1_drive_end', 'mic_volts', 'acc_2_axial_1', 'acc_3_axial_2']
    
    for start in range(0, total_samples - window_samples + 1, step_samples):
        end = start + window_samples
        sub_df = df.iloc[start:end]
        
        row_feat = {
            'file_id': meta['filename'],
            'label': meta['label'],
            'speed_hz': meta['speed_hz'],
            'load_code': meta['load_code'],
            'target_temp_mean': sub_df['temperature_celsius'].mean(),
            'target_temp_last': sub_df['temperature_celsius'].iloc[-1]
        }
        
        for col in sensor_cols:
            sig = sub_df[col].to_numpy()
            time_feats = extract_time_domain_features(sig, prefix=col)
            freq_feats = extract_frequency_features(sig, fs=fs, fundamental_freq=meta['speed_hz'], prefix=col)
            
            row_feat.update(time_feats)
            row_feat.update(freq_feats)
            
        features_list.append(row_feat)
        
    return pd.DataFrame(features_list)
