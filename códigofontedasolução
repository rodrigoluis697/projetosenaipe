def parse_filename(filepath: str) -> dict:
    """Extrai metadata do nome do arquivo."""
    filename = os.path.basename(filepath).replace('.csv', '')
    parts = filename.split('_')
    
    label = f"{parts[0]}_{parts[1]}"
    speed_code = int(parts[2])
    load_code = int(parts[3])
    
    # 1: 15 Hz, 3: 45 Hz
    speed_hz = 15.0 if speed_code == 1 else 45.0
    
    return {
        'filepath': filepath,
        'filename': filename,
        'label': label,
        'speed_code': speed_code,
        'speed_hz': speed_hz,
        'load_code': load_code
    }

